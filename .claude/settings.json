{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe *)",
      "Bash(.venv/bin/python *)",
      "Bash(py -3.11 scripts/bootstrap.py *)",
      "Bash(python scripts/bootstrap.py *)",
      "Bash(python3 scripts/bootstrap.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git push origin main)",
      "Bash(nvidia-smi *)",
      "PowerShell(.venv/Scripts/python.exe *)",
      "PowerShell(.venv\\Scripts\\python.exe *)",
      "PowerShell(py -3.11 scripts/bootstrap.py *)",
      "PowerShell(python scripts/bootstrap.py *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git pull *)",
      "PowerShell(git push origin main)",
      "PowerShell(nvidia-smi *)",
      "PowerShell(Get-ChildItem *)",
      "WebFetch(domain:www.driveandact.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:pytorch.org)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git reset *)",
      "Bash(winget *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git reset *)",
      "PowerShell(winget *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "Bash(git add data/*)",
      "PowerShell(git add data/*)"
    ]
  }
}
